# LabelForge Studio does not require any runtime environment variables for
# local development. The variables below are only used when producing a
# signed release build via `bun run dist:win` (see electron-builder.yml).

# CSC_LINK: Path or URL to the code-signing certificate (.pfx) used by electron-builder
# for Windows builds. Required only for `bun run dist:win` / `bun run dist:portable`
# when producing a signed release build. Leave unset for local/dev builds.
CSC_LINK=""

# CSC_KEY_PASSWORD: Password for the certificate referenced by CSC_LINK.
CSC_KEY_PASSWORD=""
